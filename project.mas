{
  name "Flow"
  author "Mandal Dev"
  desc "a network io lib"
  license "GPLv3"

  target {
    Flow {
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/Flower.cpp"
        "src/Error.cpp"
        "src/Socket.cpp"
        "src/AsyncSocket.cpp"
        "src/StreamSocket.cpp"
        "src/StreamMessageSocket.cpp"
        "src/Rpc.cpp"
        "src/RpcRequest.cpp"
        "src/RpcResponse.cpp"
        "src/RpcSocket.cpp"
        "src/RpcService.cpp"
        "src/RpcClient.cpp"
        "src/Timer.cpp"
        "src/Event.cpp"
      ]

      dep [
        "Com"
      ]

      install [
        {
          dir "Flow"
          headers [
            "src/Flower.hpp"
            "src/Error.hpp"
            "src/Socket.hpp"
            "src/AsyncSocket.hpp"
            "src/StreamSocket.hpp"
            "src/StreamMessageSocket.hpp"
            "src/Rpc.hpp"
            "src/RpcRequest.hpp"
            "src/RpcResponse.hpp"
            "src/RpcSocket.hpp"
            "src/RpcService.hpp"
            "src/RpcClient.hpp"
            "src/Timer.hpp"
            "src/Event.hpp"
          ]
        }
      ]
    }

    learn_tcp {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "learn/main.cpp"
        "learn/tcp_server.cpp"
        "learn/tcp_client.cpp"
      ]

      dep [
        "Com"
      ]
    }

    streamserver "check/streamserver.mas"
    streamclient "check/streamclient.mas"
    rpc_check "check/rpc.mas"
  }
}
