{
  name "flow"
  author "Mandal Dev"
  desc "a network io lib"
  license "GPLv3"

  target {
    flow {
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/Flower.cpp"
        "src/Error.cpp"
        "src/Socket.cpp"
        "src/IPv4Socket.cpp"
        "src/StreamSocket.cpp"
      ]

      dep [
        "Com"
      ]
    }

    learn_tcp {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "learn/main.cpp"
        "learn/tcp_server.cpp"
        "learn/tcp_client.cpp"
      ]

      dep [
        "Com"
      ]
    }
  }
}
