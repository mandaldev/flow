{
  name "flow"
  author "Mandal Dev"
  desc "a network io lib"
  license "GPLv3"

  target {
    flow {
      language "c++"
      std "c++17"
      type "slib"

      src [
        "src/Flower.cpp"
        "src/Error.cpp"
        "src/Socket.cpp"
        "src/AsyncSocket.cpp"
        "src/StreamSocket.cpp"
        "src/RpcSocket.cpp"
        "src/RpcService.cpp"
        "src/RpcClient.cpp"
      ]

      dep [
        "Com"
      ]

      install [
        {
          dir "Flow"
          headers [
            "src/Flower.hpp"
            "src/Error.hpp"
            "src/Socket.hpp"
            "src/AsyncSocket.hpp"
            "src/StreamSocket.hpp"
            "src/RpcSocket.hpp"
            "src/RpcService.hpp"
            "src/RpcClient.hpp"
          ]
        }
      ]
    }

    learn_tcp {
      language "c++"
      std "c++17"
      type "exe"

      src [
        "learn/main.cpp"
        "learn/tcp_server.cpp"
        "learn/tcp_client.cpp"
      ]

      dep [
        "Com"
      ]
    }

    streamserver "check/streamserver.mas"
    streamclient "check/streamclient.mas"
    rpc_check "check/rpc.mas"
  }
}
